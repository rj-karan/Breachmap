    {
      "id": "m01",
      "description": "drop the sub condition from deploy-scoped: any repo and any event can assume it",
      "edits": [
        {
          "op": "set",
          "file": "aws",
          "path": "roles[name=deploy-scoped].trust_policy.Statement[0].Condition",
          "value": {
            "StringEquals": {
              "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
            }
          }
        }
      ],
      "expected": [
        {
          "decision": "d02",
          "outcome": "allow"
        },
        {
          "decision": "d04",
          "outcome": "allow"
        }
      ]
    },
    {
