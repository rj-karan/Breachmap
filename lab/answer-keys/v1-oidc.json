{
  "fixture": "v1-oidc",
  "decisions": [
    {
      "id": "d01",
      "description": "Tinder case: trust checks only aud, so a token from any repository matches",
      "principal": {
        "web_identity": {
          "provider_arn": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com",
          "claims": {
            "sub": "repo:attacker/evil:ref:refs/heads/main",
            "aud": "sts.amazonaws.com"
          }
        }
      },
      "action": "sts:AssumeRoleWithWebIdentity",
      "resource": "arn:aws:iam::111111111111:role/deploy-aud-only",
      "outcome": "allow",
      "cites": "GitHub OIDC reference: aud is chosen by the caller (configure-aws-credentials requests sts.amazonaws.com; the `audience` input can request anything), so a condition on aud alone does not restrict which repository may assume the role"
    },
    {
      "id": "d02",
      "description": "sub-scoped trust rejects a token from another repository",
      "principal": {
        "web_identity": {
          "provider_arn": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com",
          "claims": {
            "sub": "repo:attacker/evil:ref:refs/heads/main",
            "aud": "sts.amazonaws.com"
          }
        }
      },
      "action": "sts:AssumeRoleWithWebIdentity",
      "resource": "arn:aws:iam::111111111111:role/deploy-scoped",
      "outcome": "deny",
      "reason": "condition_mismatch",
      "cites": "StringEquals: 'Exact matching, case sensitive'"
    },
    {
      "id": "d03",
      "description": "sub-scoped trust accepts the exact repo and branch",
      "principal": {
        "web_identity": {
          "provider_arn": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com",
          "claims": {
            "sub": "repo:acme/app:ref:refs/heads/main",
            "aud": "sts.amazonaws.com"
          }
        }
      },
      "action": "sts:AssumeRoleWithWebIdentity",
      "resource": "arn:aws:iam::111111111111:role/deploy-scoped",
      "outcome": "allow"
    },
    {
      "id": "d04",
      "description": "sub for a pull_request event differs from the main-branch sub",
      "principal": {
        "web_identity": {
          "provider_arn": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com",
          "claims": {
            "sub": "repo:acme/app:pull_request",
            "aud": "sts.amazonaws.com"
          }
        }
      },
      "action": "sts:AssumeRoleWithWebIdentity",
      "resource": "arn:aws:iam::111111111111:role/deploy-scoped",
      "outcome": "deny",
      "reason": "condition_mismatch",
      "cites": "GitHub docs: for pull_request events the sub is 'repo:<org>/<repo>:pull_request'"
    },
    {
      "id": "d05",
      "description": "StringLike repo:acme/* admits every repo in the org",
      "principal": {
        "web_identity": {
          "provider_arn": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com",
          "claims": {
            "sub": "repo:acme/website:ref:refs/heads/main",
            "aud": "sts.amazonaws.com"
          }
        }
      },
      "action": "sts:AssumeRoleWithWebIdentity",
      "resource": "arn:aws:iam::111111111111:role/deploy-org-wildcard",
      "outcome": "allow",
      "cites": "StringLike: 'Case-sensitive matching. The values can include multi-character match wildcards (*)'"
    },
    {
      "id": "d06",
      "description": "StringLike repo:acme/* rejects other owners",
      "principal": {
        "web_identity": {
          "provider_arn": "arn:aws:iam::111111111111:oidc-provider/token.actions.githubusercontent.com",
          "claims": {
            "sub": "repo:attacker/evil:ref:refs/heads/main",
